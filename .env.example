# Mẫu cấu hình chung cho cả repo. npm run setup tự tạo .env từ file này (mật khẩu sinh ngẫu nhiên).
# Không commit .env.

# --- Backend (backend/) ---
HOST=127.0.0.1
PORT=3000
MOCK_PAYMENT_RESULT=SUCCESS
DEMO_PASSWORD=demo12345
# Nguồn được gọi API khi mở giao diện bằng Live Server (giao diện do backend phục vụ thì không cần).
CORS_ORIGIN=http://127.0.0.1:5500
# STORE=memory     # chạy không cần MySQL, dữ liệu trong RAM
# SEED_DEMO=false  # không tự nạp dữ liệu demo khi CSDL trống

# --- CSDL MySQL (database/) — mặc định là instance riêng của dự án ở cổng 3307 ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=gomeal
DB_PASSWORD=
DB_NAME=gomeal_m3
DB_POOL_SIZE=20
# Schema chỉ dùng cho test (bị xóa dữ liệu khi chạy test) và cho đo tải
TEST_DB_NAME=gomeal_m3_test
BACKEND_TEST_DB_NAME=gomeal_m2_test
LOAD_DB_NAME=gomeal_m3_load
