{
    "name": "nhom7-m2-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Group 7 M2 - Order, Billing, Mock Payment and Dispatch",
    "engines": {
        "node": ">=24.0.0 <25"
    },
    "scripts": {
        "start": "node --env-file-if-exists=.env src/server.js",
        "demo": "node --env-file-if-exists=.env scripts/demo.js",
        "test": "node --test --test-concurrency=1 test/*.test.js",
        "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=src/services/*.js test/*.test.js",
        "check": "node scripts/check.js"
    },
    "dependencies": {
        "express": "5.1.0"
    }
}
