{
    "name": "nhom7-m2-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Group 7 M2 - static and dynamic testing with AI-assisted review",
    "engines": {
        "node": ">=24.0.0 <25"
    },
    "scripts": {
        "start": "node --env-file-if-exists=.env src/server.js",
        "demo": "node --env-file-if-exists=.env scripts/demo.js",
        "test": "node --test --test-concurrency=1 test/*.test.js",
        "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=src/services/*.js test/*.test.js",
        "check": "node scripts/check.js",
        "lint": "eslint . --max-warnings 0",
        "test:regression": "node --test test/ai-regression.test.js",
        "quality": "node scripts/verify-quality.js"
    },
    "dependencies": {
        "express": "5.1.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "eslint": "10.13.0",
        "eslint-plugin-sonarjs": "4.2.2",
        "globals": "17.13.0"
    }
}
